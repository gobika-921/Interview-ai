{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "experienceLevel": { "type": "string", "enum": ["Fresher", "Beginner", "Intermediate", "Experienced"] },
        "domain": { "type": "string" },
        "targetRole": { "type": "string" },
        "skills": { "type": "array", "items": { "type": "string" } },
        "preferredDifficulty": { "type": "string", "enum": ["Easy", "Medium", "Hard"] },
        "resumeScore": { "type": "number" },
        "resumeData": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "fullName", "email"]
    },
    "Interview": {
      "title": "Interview",
      "description": "Mock interview session record",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["aptitude", "coding", "hr", "company"] },
        "company": { "type": "string" },
        "status": { "type": "string", "enum": ["ongoing", "completed", "terminated"] },
        "score": { "type": "number" },
        "feedback": { "type": "string" },
        "details": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "type", "status", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile document"
    },
    "/interviews/{interviewId}": {
      "schema": "Interview",
      "description": "Interview session records"
    }
  }
}
