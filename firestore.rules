rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User Profile Rules
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Users can't list other users
      allow create: if isOwner(userId) && 
        incoming().keys().hasAll(['uid', 'fullName', 'email', 'createdAt']) &&
        incoming().uid == request.auth.uid;
      allow update: if isOwner(userId) && 
        incoming().uid == existing().uid;
    }

    // Interview Rules
    match /interviews/{interviewId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && 
        incoming().userId == request.auth.uid &&
        isValidId(interviewId);
      allow update: if isSignedIn() && 
        existing().userId == request.auth.uid &&
        incoming().userId == existing().userId;
      allow delete: if false; // Interviews are permanent records
    }
  }
}
